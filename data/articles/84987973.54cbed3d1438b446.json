","url":"https://flow.team/l/QsDfI"},"assets":{"https://flow.team/flowImg/FLOW_20260910873845_7447000e-55cb-404c-b230-1d26b914e397.png":"images/5035a06a4fc891c67ad6aaf17bc7af9893c7bfb72e7246bf24c48ddb9cef7ddb.png","https://flow.team/flowImg/FLOW_20260910869257_0c6589e6-e8fc-4b53-9e52-827cd2bfbf26.png":"images/b75893420b66f6bbecfd784a9933a4221a90652d156150409cf6b0c485d85bcf.png","https://flow.team/flowImg/FLOW_20260910101130_2bf9b400-e6e8-4fb6-8f84-b99ac29568ef.png":"images/170390dd0f7b101c0c74a36ce3c243c656b794ae33ad911944128eca7f3979b5.png"}}